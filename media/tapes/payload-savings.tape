Output media/out/frames/payload-savings/

Set Shell "bash"
Set FontSize 20
Set FontFamily "Menlo"
Set Width 1000
Set Height 560
Set Padding 32
Set Framerate 24
Set TypingSpeed 70ms
Set Theme { "background": "#10151e", "foreground": "#e0e6ef", "cursorColor": "#e0e6ef", "black": "#10151e", "white": "#e0e6ef" }

Type "python3 media/demo/payload-savings.py"
Sleep 500ms
Enter
Sleep 5s
