Output media/out/frames/route-and-cost/

Set Shell "bash"
Set FontSize 20
Set FontFamily "Menlo"
Set Width 1500
Set Height 360
Set Padding 32
Set Framerate 24
Set TypingSpeed 70ms
Set Theme { "background": "#10151e", "foreground": "#e0e6ef", "cursorColor": "#e0e6ef", "black": "#10151e", "white": "#e0e6ef" }

Type "bash media/demo/route-and-cost.sh"
Sleep 500ms
Enter
Sleep 12s
